(access_location_fixture) {
    rewrite * /v1/tenant/access-location
    reverse_proxy control:8000 {
        header_up X-Forwarded-For {args[0]}
    }
}

https://localhost, https://console {
	tls internal
    handle /fixture/access-location/cn {
        import access_location_fixture 223.5.5.5
    }
    handle /fixture/access-location/hk {
        import access_location_fixture 203.0.113.10
    }
    handle /fixture/access-location/source {
        respond "{http.request.remote.host}" 200
    }
    handle /fixture/* {
        respond "proxy-test" 200
    }
	@control path /v1/* /public/* /healthz
	handle @control {
		reverse_proxy control:8000
	}
	handle {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}
}

:8080 {
	handle /healthz {
		reverse_proxy control:8000
	}
    handle /supplier-auth {
        header Content-Type application/json
        respond `{"ok":true}` 200
    }
	handle /fixture {
		respond "proxy-test" 200
	}
}
