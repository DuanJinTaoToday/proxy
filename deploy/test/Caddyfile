https://localhost, https://console {
	tls internal
    handle /fixture/* {
        respond "proxy-test" 200
    }
	@control path /v1/* /public/* /healthz
	handle @control {
		reverse_proxy control:8000
	}
	handle {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}
}

:8080 {
	handle /healthz {
		reverse_proxy control:8000
	}
    handle /supplier-auth {
        header Content-Type application/json
        respond `{"ok":true}` 200
    }
	handle /fixture {
		respond "proxy-test" 200
	}
}
